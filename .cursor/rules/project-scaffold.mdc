## 🔨 Makefile Standard Targets

```makefile
.PHONY: test lint format eval diagrams docker-build docker-run clean

test:                ## Run all tests
	uv run pytest tests/ -v

lint:                ## Run linting (ruff + mypy)
	uv run ruff check src/ tests/
	uv run mypy src/

format:              ## Auto-format code (ruff format + lint autofix)
	uv run ruff format src/ tests/
	uv run ruff check --fix src/ tests/

eval:                ## Run AI evaluation tests
	uv run deepeval test run tests/test_eval.py

diagrams:            ## Export C4 views from architecture.dsl to Mermaid for the README
	structurizr-cli export -workspace architecture.dsl -format mermaid -output docs/diagrams

docker-build:        ## Build Docker image
	docker build -t $(PROJECT_NAME) .

docker-run:          ## Run Docker container
	docker run -p 8501:8501 --env-file .env $(PROJECT_NAME)

clean:               ## Remove build artifacts
	find . -type d -name __pycache__ -exec rm -rf {} +
	find . -type f -name "*.pyc" -delete
	rm -rf .pytest_cache .ruff_cache htmlcov dist build
```

