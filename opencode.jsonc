{
  // ---------------------------------------------------------------------------
  // OpenCode project config  ·  Manuel Reyes  ·  Stage 1 — Internal AI Builder
  // Roadmap v10.0 (3-stage arc: Internal AI Builder → AI-Focused DE/AE → Applied
  // AI Engineer / FDE track).
  // Place at the repository root as `opencode.jsonc` (ADR-001 §5a).
  //
  // FORMAT: OpenCode 2.x native schema — migrated Nov 2026 from the 1.x format.
  //   Requires the 2.x runtime (check `opencode --version`). The 1.x binary does
  //   not know `agents` / `providers` / `permissions`.
  // Docs verified Nov 2026: opencode.ai/docs/{migrate-v1,agents,permissions,
  //   providers,models,go}
  //
  // V1 → V2 KEY MAP applied in this file:
  //   provider     → providers            agent      → agents
  //   permission   → permissions          small_model → agents.title.model
  //   bash (tool)  → shell (action)       "git status*" → "git status *"
  //   { pattern: effect } objects → ordered arrays of
  //   { action, resource, effect } — the LAST MATCHING RULE WINS, so every list
  //   below goes: broad rule first → exceptions → hard stops last.
  //
  // PROVIDER STRATEGY: OpenCode Go = primary (flat $10/mo, hard-capped; the
  // $5 first month ended Aug 24, 2026); OpenRouter = overflow (metered, only
  // bills when used). Same model slugs on both so F2 switching is seamless when
  // a Go window blocks. Keep "Extra Usage" (formerly "Use balance") OFF on the
  // Console Go page so Go BLOCKS at its limits instead of billing your credit.
  //
  // LOCAL MODELS REMOVED (Nov 2026): Ollama / LM Studio Qwen3.5 9B fell short for
  // planning and analysis (the C41 §7 falsifier fired). Consequence: NO agent in
  // this harness keeps data on the machine any more — every plan, build and
  // session title goes to a cloud provider. The privacy boundary is now ONLY
  // the repository itself (C41 §3–4): synthetic data only, enforced by gitleaks +
  // detect-private-key in pre-commit. Never open OpenCode in a working tree that
  // holds real participant data, and never paste real records into a session.
  // ---------------------------------------------------------------------------
  "$schema": "https://opencode.ai/config.json",

  // === Default model =========================================================
  // Primary agents use this unless they override it.
  //
  // ⚠ V2 MODEL RULE — the FOOTER is the truth, not this file. A session stores
  // its model separately from its agent. A model you pick by hand (/models, F2)
  // for an agent in a tab wins over that agent's `model` key here, and Tab
  // restores each agent's last-used model. Several open issues report agents'
  // configured models not applying at all. Check the footer
  // ("Plan-Cloud · <model>") before work that depends on the model. Subagents
  // are not affected: they always run their own configured model.
  "model": "opencode-go/glm-5.2",

  // === Global permissions — apply to EVERY agent, before its own rules =======
  // V2 changed one default quietly: reads and edits OUTSIDE the project now run
  // without a prompt (V1 asked). This one rule restores the V1 behaviour.
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  // === Providers =============================================================
  // Both are catalog providers — add each key once via /connect (credentials live
  // in OpenCode's auth store, never in this file). Listing models here only pins
  // tidy display names for /models and F2. The map key IS the model ID.
  "providers": {
    // --- PRIMARY: OpenCode Go ($10/mo flat, hard-capped) ---------------------
    // Connect once: /connect -> OpenCode Go -> paste sk-... key.
    // Slugs drop the vendor sub-path OpenRouter requires:
    //   OpenRouter  openrouter/z-ai/glm-5.2
    //   Go          opencode-go/glm-5.2
    //
    // TIER = list-price VALUE allowance, not request volume. Counter-intuitively a
    // cheap reduced-tier model can buy MORE requests than a costly full-tier one.
    // Checked Nov 18, 2026. The Go docs table and the Go page estimates differ by
    // ~10%, so treat these as planning numbers (/hr assumes ~108 hr/mo):
    //   minimax-m3       FULL $60  ~16,000 req/mo   (~149/hr)
    //   deepseek-v4-pro  RED  $15  ~ 5,200 req/mo   (~48/hr)  <- beats glm-5.2!
    //   glm-5.2          FULL $60  ~ 4,300 req/mo   (~40/hr)
    //   glm-5.3          RED  $15  ~ 1,080 req/mo   (~10/hr)  same token price as 5.2
    //   kimi-k3.1-pro    RED  $15  ~   735 req/mo   (~6.8/hr) <- scarce, ration it
    //   (kimi-k3, replaced Nov 18: ~490 req/mo)
    //
    // VERIFIED (was the open question): ONE SHARED allowance. A model's monthly
    // limit is how much of the pool it would use if used alone — $1.50 on a $15
    // model = 10% of the month; $1.50 on a $60 model = 2.5%. Windows: 20% of the
    // pool per 5 h, 50% per week (resets Mon 00:00 UTC). Limits change often —
    // re-check the Console before relying on these numbers.
    "opencode-go": {
      "models": {
        "glm-5.2":         { "name": "GLM-5.2 (build · plan · DEFAULT) [FULL $60]" },
        "minimax-m3":      { "name": "MiniMax M3 (session titles · bulk) [FULL $60]" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro (build · alt) [RED $15]" },
        "kimi-k3.1-pro":   { "name": "Kimi K3.1 Pro (hard plan / review ONLY) [RED $15]" },
        "glm-5.3":         { "name": "GLM-5.3 (build-hard · TRIAL) [RED $15]" }
      }
    },

    // --- OVERFLOW: OpenRouter (metered; only bills when used) ----------------
    // When a Go window blocks, F2 to the matching slug here. NOTE: Go is curated
    // single-provider; OpenRouter routes across providers and quantisations, so
    // the same slug can serve differently. Expect minor output drift, not a bug.
    "openrouter": {
      "models": {
        "z-ai/glm-5.2":               { "name": "GLM-5.2 (overflow · build default)" },
        "minimax/minimax-m3":         { "name": "MiniMax M3 (overflow · bulk)" },
        "deepseek/deepseek-v4-pro":   { "name": "DeepSeek V4 Pro (overflow · build alt)" },
        "moonshotai/kimi-k3.1-pro":   { "name": "Kimi K3.1 Pro (overflow · hard plan/review)" },
        "z-ai/glm-5.3":               { "name": "GLM-5.3 (overflow · build-hard trial)" },
        "deepseek/deepseek-v4-flash": { "name": "DeepSeek V4 Flash (CHEAP overflow $0.14/$0.28)" },
        "qwen/qwen3.7-max":           { "name": "Qwen3.7 Max (overflow · legacy alt)" }
      }
    }
  },

  // === Agents: your non-vibecode loop ========================================
  "agents": {
    // === TITLE — hidden system agent; replaces V1 `small_model` =============
    // Writes session titles. It used to be pinned local so titles never left the
    // machine; it is now cloud. MiniMax M3 has the largest Go allowance, so each
    // title call spends the least scarce budget.
    "title": { "model": "opencode-go/minimax-m3" },

    // === HELPER SUBAGENTS — built-in, model pinned ===========================
    // A subagent with no model of its own INHERITS its parent's model. Pinning
    // these two does two jobs: (1) a scarce $15 model never leaks into helper
    // work, and (2) `build` and `build-hard` delegate to the SAME helpers, so the
    // trial below compares the main model only. No change for existing agents —
    // every agent that may launch them already runs GLM-5.2.
    "general": { "model": "opencode-go/glm-5.2" },
    "explore": { "model": "opencode-go/glm-5.2" },

    // === PLAN — built-in, DISABLED =========================================
    // The built-in `plan` was the local-only privacy boundary. With local
    // models removed it has no job left, and V2's built-in default would let
    // it run shell freely (the base policy allows everything). One planner, one
    // home (ADR-001 §5a): `plan-cloud` below. All 8 commands route there.
    "plan": { "disabled": true },

    // === PLAN-CLOUD — default planner (Tab-selectable) ======================
    // Synthetic/public repos only — which is now every repo OpenCode may open.
    //
    // WHY GLM-5.2 AND NOT MINIMAX M3: plan output is the architecture every later
    // build depends on, and a bad plan propagates silently where a bad diff does
    // not. Volume is low (~80-120 calls/mo at 25 hr/wk), so the larger M3
    // allowance buys nothing here — spend reasoning quality instead. AA Index 51
    // vs M3's 44.
    //
    // NOT DeepSeek V4 Pro: tied with M3 at AA 44, and it can look frozen in Plan
    // mode (reasoning-MoE + ai-sdk thinking-stream). That is not a hang, but it is
    // a poor fit for an interactive planning loop.
    "plan-cloud": {
      "mode": "primary",
      "description": "Default planner. Read-only against all source; may write only the Gate 1 task brief under .github/plans/. Synthetic/public repos only.",
      "model": "opencode-go/glm-5.2",
      "permissions": [
        // ADR-0002: read-only against ALL source; the Gate 1 task brief is the
        // single exception. Broad deny first, exception after (last match wins).
        { "action": "edit", "resource": "*", "effect": "deny" },
        // The same exception written twice: relative path and absolute path.
        // V2 `*` crosses `/`, so both are recursive (`**` is no longer needed).
        // If V2 resolves edit paths differently than expected, the deny above
        // still holds — this fails CLOSED (no brief written), never open.
        { "action": "edit", "resource": ".github/plans/*",   "effect": "allow" },
        { "action": "edit", "resource": "*/.github/plans/*", "effect": "allow" },

        { "action": "shell", "resource": "*", "effect": "deny" },

        // Subagents: READ-ONLY ones only. A read-only agent that can launch an
        // editing agent is not read-only — V2 subagents run on THEIR OWN
        // permissions, not the parent's. Denied here: `general` (edits + shell),
        // `docs-fix` (edits docs), `eval-guardian` (runs test commands).
        // A denied subagent is invisible to this agent: "@docs-fix" from here
        // makes the planner improvise instead of delegating (seen Nov 18).
        { "action": "subagent", "resource": "*",                "effect": "deny" },
        { "action": "subagent", "resource": "explore",          "effect": "allow" },
        { "action": "subagent", "resource": "docs-sync",        "effect": "allow" },
        { "action": "subagent", "resource": "security-auditor", "effect": "allow" },
        { "action": "subagent", "resource": "pattern-scout",    "effect": "allow" }
      ]
      // ADR-0003: this gates the agent's shell TOOL, not command-template `!`,
      // which the .github/scripts context loaders rely on. Verified on 1.17.9
      // only — RE-VERIFY on 2.x (run /test once from `plan-cloud`).
    },

    // === PLAN — HARD ARCHITECTURE (Tab-selectable) ==========================
    // Kimi K3.1 Pro: AA Index v5 46 (top open-weight model), Terminal-Bench 4.0
    // 67.2% on AA's harness. RED tier, ~735 req/mo (~6.8/hr) — the scarcest model
    // in this config. Planning is low-volume enough that this is
    // affordable IF reserved for genuinely hard calls:
    //   - ADR-worthy decisions where a real rejected alternative is the content
    //   - cross-cutting architecture (ingestion topology, eval-gate design)
    //   - anything you expect to defend in an interview
    // Do NOT use for routine session planning — that is `plan-cloud`'s job.
    "plan-cloud-hard": {
      "mode": "primary",
      "description": "Hard architecture planning on Kimi K3.1 Pro for ADR-worthy and cross-cutting decisions. Scarce allowance; use sparingly.",
      "model": "opencode-go/kimi-k3.1-pro",
      "permissions": [
        { "action": "edit",  "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        // Same read-only subagents as `plan-cloud`. Safe for the Kimi allowance
        // now: `explore` is pinned to GLM-5.2 and each custom subagent names its
        // own model, so nothing here inherits Kimi K3.1 Pro.
        { "action": "subagent", "resource": "*",                "effect": "deny" },
        { "action": "subagent", "resource": "explore",          "effect": "allow" },
        { "action": "subagent", "resource": "docs-sync",        "effect": "allow" },
        { "action": "subagent", "resource": "security-auditor", "effect": "allow" },
        { "action": "subagent", "resource": "pattern-scout",    "effect": "allow" }
      ]
      // Read-only for AGENT-INITIATED actions only. Command-template `!` is NOT
      // gated here (ADR-0003, verified on 1.17.9 — re-verify on 2.x).
    },

    // === BUILD — built-in, overridden =======================================
    // BUILD LADDER (F2 / /models to switch mid-session):
    //   1. opencode-go/glm-5.2         DEFAULT — FULL tier, MIT, fastest (~168 tok/s),
    //                                  81% Terminal-Bench, beats GPT-5.5 on SWE-bench Pro
    //                                  ⚠ AA lists GLM-5.2 as deprecated by Z.ai (Nov 2026)
    //                                  and has no v5 score for it — plan a successor.
    //   2. opencode-go/deepseek-v4-pro ALT — V4 Pro 0813, MIT. AA v5 cost per task
    //                                  $0.85 (high) / $1.77 (max); cache hits $0.044/M
    //   3. opencode-go/glm-5.3         HARD BUILD — TRIAL via the `build-hard` agent
    //                                  below (Nov 18 →). Not a default: $15 tier.
    //   overflow: same slugs under openrouter/*, or deepseek-v4-flash for cheap bulk.
    //
    // NOT a build model: opencode-go/kimi-k3.1-pro. It stays on hard PLANNING and
    // /review — short, low-volume calls, where it is strongest. In long build
    // sessions it is slower and costs more (see `build-hard` below).
    "build": {
      "model": "opencode-go/glm-5.2",
      "permissions": [
        // Looser: apply edits without a per-diff prompt. Your gate is the
        // git-diff review + manual commit.
        { "action": "edit",  "resource": "*", "effect": "allow" },

        // Shell: ask by default, then allow-list read-only git + quality gates.
        // A pattern ending in ` *` also matches the bare command (`git status`).
        { "action": "shell", "resource": "*",               "effect": "ask" },
        { "action": "shell", "resource": "git status *",    "effect": "allow" },
        { "action": "shell", "resource": "git diff *",      "effect": "allow" },
        { "action": "shell", "resource": "git log *",       "effect": "allow" },
        { "action": "shell", "resource": "git add *",       "effect": "allow" },
        { "action": "shell", "resource": "make test",       "effect": "allow" },
        { "action": "shell", "resource": "make lint",       "effect": "allow" },
        { "action": "shell", "resource": "make eval",       "effect": "allow" },
        { "action": "shell", "resource": "make diagrams",   "effect": "allow" },
        { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
        { "action": "shell", "resource": "uv run ruff *",   "effect": "allow" },
        { "action": "shell", "resource": "uv run mypy *",   "effect": "allow" },
        { "action": "shell", "resource": "pytest *",        "effect": "allow" },
        { "action": "shell", "resource": "ruff *",          "effect": "allow" },
        { "action": "shell", "resource": "mypy *",          "effect": "allow" },

        // Hard stops LAST so nothing above can re-allow them. You ALWAYS commit
        // manually. V2 splits compound commands (`a && b`) and any deny wins.
        { "action": "shell", "resource": "git commit *",    "effect": "deny" },
        { "action": "shell", "resource": "git push *",      "effect": "deny" }
      ]
    },

    // === BUILD-HARD — TRIAL (Tab-selectable) ================================
    // Same permissions as `build` (copied verbatim) so the ONLY variable in the
    // trial is the model. Use it for the hard tasks you would otherwise give to
    // `build`: multi-file changes, cross-module refactors, tricky test failures.
    //
    // WHY GLM-5.3 AND NOT KIMI K3.1 PRO (decided Nov 18):
    //   - Benchmarks favour Kimi (AA v5 46 vs 32; Terminal-Bench 4.0 67.2% vs 41.9%)
    //     and Kimi wins SHORT hard sessions (Bito: 60.3% vs 51.2%).
    //   - Long agentic sessions — which is what build work is — favour GLM-5.3
    //     (Bito 20-turn: 74.0% vs 54.8%), at a quarter to a third of Kimi's
    //     session cost and ~3x its speed. Kimi resends ~0.5–1M tokens of context
    //     per request.
    //   - Both sit on the $15 Go tier; GLM-5.3 is cheaper per token ($1.40/$4.40
    //     vs $2/$10) and gets ~1.5x the requests per 5 h.
    //
    // HOW TO RUN THE TRIAL (details: getting_started/agentic-worklow/
    // dual_harness_workflow.md §3.2): same task brief, same commit, two git
    // worktrees — `build` in one, `build-hard` in the other. CONFIRM THE FOOTER
    // shows GLM-5.2 vs GLM-5.3 before each run (see the V2 model rule at the
    // top); if not, pick it with /models. Log per task: footer model, checks
    // pass first try (make test / lint / mypy), review fixes you had to make,
    // minutes, and Go usage % from the Console.
    // DECIDE after ~10 hard tasks: keep `build-hard` only if it needs clearly
    // fewer review fixes AND the shared Go pool holds; otherwise delete this block.
    "build-hard": {
      "mode": "primary",
      "description": "TRIAL: build on GLM-5.3 for hard multi-file tasks, A/B-tested against `build` (GLM-5.2). Same permissions as build. Scarce $15 Go allowance.",
      "model": "opencode-go/glm-5.3",
      "permissions": [
        // Looser: apply edits without a per-diff prompt. Your gate is the
        // git-diff review + manual commit.
        { "action": "edit",  "resource": "*", "effect": "allow" },

        // Shell: ask by default, then allow-list read-only git + quality gates.
        // A pattern ending in ` *` also matches the bare command (`git status`).
        { "action": "shell", "resource": "*",               "effect": "ask" },
        { "action": "shell", "resource": "git status *",    "effect": "allow" },
        { "action": "shell", "resource": "git diff *",      "effect": "allow" },
        { "action": "shell", "resource": "git log *",       "effect": "allow" },
        { "action": "shell", "resource": "git add *",       "effect": "allow" },
        { "action": "shell", "resource": "make test",       "effect": "allow" },
        { "action": "shell", "resource": "make lint",       "effect": "allow" },
        { "action": "shell", "resource": "make eval",       "effect": "allow" },
        { "action": "shell", "resource": "make diagrams",   "effect": "allow" },
        { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
        { "action": "shell", "resource": "uv run ruff *",   "effect": "allow" },
        { "action": "shell", "resource": "uv run mypy *",   "effect": "allow" },
        { "action": "shell", "resource": "pytest *",        "effect": "allow" },
        { "action": "shell", "resource": "ruff *",          "effect": "allow" },
        { "action": "shell", "resource": "mypy *",          "effect": "allow" },

        // Hard stops LAST so nothing above can re-allow them. You ALWAYS commit
        // manually. V2 splits compound commands (`a && b`) and any deny wins.
        { "action": "shell", "resource": "git commit *",    "effect": "deny" },
        { "action": "shell", "resource": "git push *",      "effect": "deny" }
      ]
    },

    // === BUILD — GATED (Tab-selectable) =====================================
    // Same ladder and shell rules as `build`, but edits are gated BEFORE the write
    // instead of after: y accept · n reject · d full diff · e edit before accepting.
    //
    // USE THIS FOR: unfamiliar libraries/patterns, first pass on a new subsystem,
    // single-file work, deliberate learning sessions. The slowdown IS the point —
    // it forces the conceptual-inquiry loop rather than delegation.
    //
    // DO NOT USE FOR: large multi-file refactors (e.g. the DataVault S2 Polars
    // rewrite). Per-edit approval hides the whole-change picture, and 15 sequential
    // prompts produce reflex-`y` approval — a gate that feels real but is not.
    // Use plain `build` + `git diff` there.
    //
    // NOTE: the inline diff shows ~4 lines of context — press Ctrl+F for
    // fullscreen before accepting anything non-trivial.
    //
    // PRECONDITION FOR BOTH BUILD AGENTS: start every session on a CLEAN tree
    // (commit or stash first). Otherwise `git diff` mixes your edits with the
    // agent's and the review stops being trustworthy.
    "build-gated": {
      "mode": "primary",
      "description": "Build with a pre-write diff gate on every edit. For unfamiliar code, new patterns, and learning sessions. Prefer plain `build` for multi-file refactors.",
      "model": "opencode-go/glm-5.2",
      "permissions": [
        // Gate BEFORE the write, not after.
        { "action": "edit",  "resource": "*", "effect": "ask" },

        { "action": "shell", "resource": "*",               "effect": "ask" },
        { "action": "shell", "resource": "git status *",    "effect": "allow" },
        { "action": "shell", "resource": "git diff *",      "effect": "allow" },
        { "action": "shell", "resource": "git log *",       "effect": "allow" },
        { "action": "shell", "resource": "git add *",       "effect": "allow" },
        { "action": "shell", "resource": "make test",       "effect": "allow" },
        { "action": "shell", "resource": "make lint",       "effect": "allow" },
        { "action": "shell", "resource": "make eval",       "effect": "allow" },
        { "action": "shell", "resource": "make diagrams",   "effect": "allow" },
        { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
        { "action": "shell", "resource": "uv run ruff *",   "effect": "allow" },
        { "action": "shell", "resource": "uv run mypy *",   "effect": "allow" },
        { "action": "shell", "resource": "pytest *",        "effect": "allow" },
        { "action": "shell", "resource": "ruff *",          "effect": "allow" },
        { "action": "shell", "resource": "mypy *",          "effect": "allow" },

        { "action": "shell", "resource": "git commit *",    "effect": "deny" },
        { "action": "shell", "resource": "git push *",      "effect": "deny" }
      ]
    }
  },

  // === Rule loading ==========================================================
  // `instructions` is unchanged in V2. AGENTS.md is loaded automatically — it
  // holds the behavioural contract and the production non-negotiables, and it is
  // ALSO read natively by Cursor and Claude Code, so it stays the single portable
  // source of truth. (V2 no longer reads CLAUDE.md — AGENTS.md is the one to keep.)
  //
  // IMPORTANT: `instructions` is FLAT — OpenCode has no glob-activation semantics.
  // Every file listed here loads in EVERY session, regardless of the `globs:` /
  // `alwaysApply:` frontmatter (those are Cursor-only). So list only the rules that
  // apply to nearly all work; route the specialist rules per-agent instead (below).
  "instructions": [
    ".cursor/rules/python-core.mdc",        // style, types, docstrings, pandas, errors
    ".cursor/rules/observability.mdc",      // structlog, stamina, pydantic-settings, secrets
    ".cursor/rules/project-scaffold.mdc"    // tree, uv, ruff/mypy, Makefile, Docker, CI
  ]

  // === Specialist rules — routed per agent ===================================
  // Each specialist rule is INLINED into its agent's prompt, so it loads only when
  // that agent runs, not on every session (the per-agent equivalent of Cursor's
  // glob scoping). OpenCode 2.x does NOT expand {file:...} in agent files (probed
  // 2026-11-18, ADR-001 §14 row 8), so `.opencode/agents/` is GENERATED:
  //   edit   .github/docs/prompts/opencode-agents/<name>.md  (template)
  //   run    make opencode-agents                            (or make harness-gen)
  //   never  edit .opencode/agents/*.md by hand — pre-commit and CI reject drift.
  // The `instructions` list above is different: it DOES load in 2.x (same probe).
  //
  //   eval-guardian.md    -> testing-and-eval.mdc
  //   docs-sync.md        -> architecture-docs.mdc
  //   docs-fix.md         -> architecture-docs.mdc + git-workflow.mdc
  //   security-auditor.md -> observability.mdc + ai-sdk-patterns.mdc
  //   pattern-scout.md    -> ai-sdk-patterns.mdc
  //   learn.md            -> learning-mode.mdc            (mode: primary, Tab-selectable)
  //
  // V2 STATUS of the Markdown agents/commands (migrated in the same patch):
  //   - Agents use `permissions:` arrays; `temperature` removed (V2 no longer
  //     sends agent-level temperature to the model).
  //   - RESOLVED 2026-11-18: `{file:...}` in an agent body is NOT expanded in
  //     2.x — docs-sync quoted its import lines verbatim. Fixed by generation
  //     (scripts/build_opencode_agents.py), see the specialist-rules note above.
  //   - Commands: `subtask` → `subagent`. V2 docs say subtask currently has no
  //     effect (commands run in the current session), so verify that context
  //     isolation still happens before relying on it.
  //
  // `streamlit-patterns.mdc` is narrow enough to reference ad hoc with @ when
  // working in `app/` — it does not need a standing route. NOTE: V2 commands do
  // not expand @path inside stored templates; @ still works when typed in chat.
  //
  // NOTE: observability.mdc is in `instructions` AND routed to security-auditor.
  // That is intentional and harmless — a subagent runs in its own context, so
  // there is no double-load in a single window.
  //
  // Cursor loads all nine rules by glob automatically; nothing extra is needed there.
}
