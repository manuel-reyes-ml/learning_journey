{
  // ---------------------------------------------------------------------------
  // OpenCode project config  ·  Manuel Reyes  ·  Stage 1 — Internal AI Builder
  // Roadmap v10.0 (3-stage arc: Internal AI Builder → AI-Focused DE/AE → Applied
  // AI Engineer / FDE track).
  // Place at project root as `opencode.json` (or keep `.jsonc` for comments).
  // Docs verified: opencode.ai/docs/{providers,agents,commands,rules,config,go}
  //
  // PROVIDER STRATEGY (Aug 2026): OpenCode Go = primary (flat $10/mo, hard-capped);
  // OpenRouter = overflow (metered, only bills when used). Same model slugs on both
  // so F2 switching is seamless when a Go window blocks. Keep "Use balance" OFF in
  // the Zen console so Go BLOCKS at its limits instead of billing through.
  // ---------------------------------------------------------------------------
  "$schema": "https://opencode.ai/config.json",

  // === Default + small model =================================================
  // Primary agents use `model` unless they override it. `small_model` handles
  // session titles/summaries — pinned LOCAL so finance work never leaks to cloud.
  "model": "opencode-go/glm-5.2",
  "small_model": "ollama/qwen3.5-16k",

  // === Providers =============================================================
  "provider": {
    // Local, free, private — your finance/proprietary default.
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        // Key MUST match the Ollama tag exactly (run `ollama list`).
        "qwen3.5:9b":  { "name": "Qwen3.5 9B (local)" },
        "qwen3.5-16k": { "name": "Qwen3.5 9B · 16k (local)" }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": { "baseURL": "http://localhost:1234/v1" },
      "models": {
        "qwen3.5-9b": { "name": "Qwen3.5 9B · MLX (LM Studio)" }
      }
    },
    // Both cloud providers are built-in — add each key once via /connect
    // (stored in ~/.local/share/opencode/auth.json). Naming the slugs here just
    // makes them tidy to pick in /models and cycle with F2. Slugs are yours.

    // --- PRIMARY cloud provider: OpenCode Go ($10/mo flat, hard-capped) ------
    // Connect once: /connect -> OpenCode Go -> paste sk-... key.
    // Slugs drop the vendor sub-path OpenRouter requires:
    //   OpenRouter  openrouter/z-ai/glm-5.2
    //   Go          opencode-go/glm-5.2
    //
    // TIER = list-price VALUE allowance, not request volume. Counter-intuitively a
    // cheap reduced-tier model can buy MORE requests than a costly full-tier one:
    //   minimax-m3       FULL $60  ~16,000 req/mo   (~150/hr @ 25 hr/wk)
    //   deepseek-v4-pro  RED  $15  ~ 5,200 req/mo   (~49/hr)  <- beats glm-5.2!
    //   glm-5.2          FULL $60  ~ 4,300 req/mo   (~40/hr)
    //   kimi-k3          RED  $15  ~   490 req/mo   (~4.6/hr) <- scarce, ration it
    //
    // UNVERIFIED: whether $15 and $60 are separate per-model allowances or
    // proportional draws on one shared $60 pool. Watch the console in month 1 —
    // if mixed usage drains faster than expected, it is a shared pool.
    "opencode-go": {
      "models": {
        "glm-5.2":         { "name": "GLM-5.2 (build · DEFAULT) [FULL $60]" },
        "minimax-m3":      { "name": "MiniMax M3 (plan · public repos) [FULL $60]" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro (build · alt) [RED $15]" },
        "kimi-k3":         { "name": "Kimi K3 (hard / frontend ONLY) [RED $15]" }
      }
    },

    // --- OVERFLOW provider: OpenRouter (metered; only bills when used) -------
    // When a Go window blocks, F2 to the matching slug here. NOTE: Go is curated
    // single-provider; OpenRouter routes across providers and quantisations, so the
    // same slug can serve differently. Expect minor output drift, not a bug.
    "openrouter": {
      "models": {
        "z-ai/glm-5.2":                 { "name": "GLM-5.2 (overflow · build default)" },
        "minimax/minimax-m3":           { "name": "MiniMax M3 (overflow · plan public)" },
        "deepseek/deepseek-v4-pro":     { "name": "DeepSeek V4 Pro (overflow · build alt)" },
        "moonshotai/kimi-k3":           { "name": "Kimi K3 (overflow · hard/frontend)" },
        "deepseek/deepseek-v4-flash":   { "name": "DeepSeek V4 Flash (CHEAP overflow $0.14/$0.28)" },
        "qwen/qwen3.7-max":             { "name": "Qwen3.7 Max (overflow · legacy alt)" }
      }
    }
  },

  // === Built-in primary agents: your non-vibecode loop =======================
  "agent": {
    // === PLAN — REGULATED / PROPRIETARY (default) ===========================
    // LOCAL ONLY. Plan mode READS THE REPO, so on DataVault / PostCheck
    // non-synthetic runs this agent is the ERISA privacy boundary — not just
    // `small_model`. Never point this at a cloud provider.
    "plan": {
      "model": "ollama/qwen3.5-16k",
      "permission": { "edit": "deny", "bash": "deny" }
      // Read-only for AGENT-INITIATED actions only. Command-template `!` is NOT
      // gated here: it runs client-side before any agent exists (ADR-0003).
    },

    // === PLAN — PUBLIC / SYNTHETIC repos (Tab-selectable) ===================
    // Use ONLY where no regulated or proprietary data is in the working tree.
    //
    // WHY GLM-5.2 AND NOT MINIMAX M3: plan output is the architecture every later
    // build depends on, and a bad plan propagates silently where a bad diff does
    // not. Volume is low (~80-120 calls/mo at 25 hr/wk), so the larger M3 allowance
    // buys nothing here — spend reasoning quality instead. AA Index 51 vs M3's 44.
    //
    // NOT DeepSeek V4 Pro: tied with M3 at AA 44, and it can look frozen in Plan
    // mode (reasoning-MoE + ai-sdk thinking-stream). That is not a hang, but it is
    // a poor fit for an interactive planning loop.
    "plan-cloud": {
      "mode": "primary",
      "description": "Planning for PUBLIC/synthetic repos only — cloud-routed. Do not use on regulated data.",
      "model": "opencode-go/glm-5.2",
      "permission": {
        // ADR-0002: read-only against ALL source; the Gate 1 task brief is the
        // single exception. Pattern is worktree-RELATIVE — an absolute or `~`
        // pattern silently never matches (opencode#40945) and fails open.
        "edit": { "*": "deny", ".github/plans/**": "allow" },
        "bash": "deny"
        // ADR-0003: this gates the agent's Bash TOOL, not command-template `!`,
        // which the .github/scripts context loaders rely on. Verified twice on
        // 1.17.9: shell ran and wrote to disk under this exact block.
      }
    },

    // === PLAN — HARD ARCHITECTURE (Tab-selectable, PUBLIC repos only) =======
    // Kimi K3: AA Index 57, GPQA 93.5 — the strongest reasoning available on Go.
    // RED tier, ~490 req/mo (~4.6/hr). Planning is low-volume enough that this is
    // affordable IF reserved for genuinely hard calls:
    //   - ADR-worthy decisions where a real rejected alternative is the content
    //   - cross-cutting architecture (ingestion topology, eval-gate design)
    //   - anything you expect to defend in an interview
    // Do NOT use for routine session planning — that is plan-cloud's job.
    "plan-cloud-hard": {
      "mode": "primary",
      "description": "Hard architecture planning on Kimi K3 — ADR-worthy and cross-cutting decisions. PUBLIC/synthetic repos only. Scarce allowance; use sparingly.",
      "model": "opencode-go/kimi-k3",
      "permission": { "edit": "deny", "bash": "deny" }
      // Read-only for AGENT-INITIATED actions only. Command-template `!` is NOT
      // gated here: it runs client-side before any agent exists (ADR-0003).
    },
    "build": {
      // BUILD LADDER (F2 / /models to switch mid-session):
      //   1. opencode-go/glm-5.2         DEFAULT — FULL tier, MIT, fastest (~168 tok/s),
      //                                  81% Terminal-Bench, beats GPT-5.5 on SWE-bench Pro
      //   2. opencode-go/deepseek-v4-pro ALT — 80.6% SWE-bench Verified (top open score),
      //                                  cheapest per task ($0.04 vs Kimi K3's $0.94)
      //   3. opencode-go/kimi-k3         HARD / FRONTEND ONLY — #3 AA Index, #1 Arena
      //                                  Frontend Code Arena. ~490 req/mo = ~1 per 13 min
      //                                  of work. Ration it.
      //   overflow: same slugs under openrouter/*, or deepseek-v4-flash for cheap bulk.
      //
      // GLM-5.3 deliberately EXCLUDED: reduced $15 tier, first-party benchmarks only,
      // weights promised not shipped — while GLM-5.2 sits on FULL tier with ~4x the
      // requests. Revisit only as an experiment, not in the standing ladder.
      "model": "opencode-go/glm-5.2",
      "permission": {
        "edit": "allow",              // looser: apply edits without a per-diff prompt
                                      // your gate is now the git-diff review + manual commit
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "make test": "allow",
          "make lint": "allow",
          "make eval": "allow",
          "make diagrams": "allow",
          "uv run pytest*": "allow",
          "uv run ruff*": "allow",
          "uv run mypy*": "allow",
          "pytest*": "allow",
          "ruff*": "allow",
          "mypy*": "allow",
          "git commit*": "deny",      // you ALWAYS commit manually
          "git push*": "deny"
        }
      }
    },

    // === BUILD — GATED (Tab-selectable) =====================================
    // Same ladder and bash rules as `build`, but edits are gated BEFORE the write
    // instead of after: y accept · n reject · d full diff · e edit before accepting.
    //
    // USE THIS FOR: unfamiliar libraries/patterns, first pass on a new subsystem,
    // single-file work, deliberate learning sessions. The slowdown IS the point —
    // it forces the conceptual-inquiry loop rather than delegation.
    //
    // DO NOT USE FOR: large multi-file refactors (e.g. the DataVault S2 Polars
    // rewrite). Per-edit approval hides the whole-change picture, and 15 sequential
    // prompts produce reflex-`y` approval — a gate that feels real but is not.
    // Use plain `build` + `git diff` there.
    //
    // NOTE: OpenCode's inline diff shows ~4 lines of context — press Ctrl+F for
    // fullscreen before accepting anything non-trivial.
    //
    // PRECONDITION FOR BOTH BUILD AGENTS: start every session on a CLEAN tree
    // (commit or stash first). Otherwise `git diff` mixes your edits with the
    // agent's and the review stops being trustworthy.
    "build-gated": {
      "mode": "primary",
      "description": "Build with a pre-write diff gate on every edit. For unfamiliar code, new patterns, and learning sessions. Prefer plain `build` for multi-file refactors.",
      "model": "opencode-go/glm-5.2",
      "permission": {
        "edit": "ask",                // gate BEFORE the write, not after
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "make test": "allow",
          "make lint": "allow",
          "make eval": "allow",
          "make diagrams": "allow",
          "uv run pytest*": "allow",
          "uv run ruff*": "allow",
          "uv run mypy*": "allow",
          "pytest*": "allow",
          "ruff*": "allow",
          "mypy*": "allow",
          "git commit*": "deny",      // you ALWAYS commit manually
          "git push*": "deny"
        }
      }
    }
  },

  // === Rule loading ==========================================================
  // AGENTS.md is loaded automatically — it holds the behavioural contract and the
  // production non-negotiables. It is ALSO read natively by Cursor and Claude Code,
  // so it is the single portable source of truth.
  //
  // IMPORTANT: `instructions` is FLAT — OpenCode has no glob-activation semantics.
  // Every file listed here loads in EVERY session, regardless of the `globs:` /
  // `alwaysApply:` frontmatter (those are Cursor-only). So list only the rules that
  // apply to nearly all work; route the specialist rules per-agent instead (below).
  "instructions": [
    ".cursor/rules/python-core.mdc",        // style, types, docstrings, pandas, errors
    ".cursor/rules/observability.mdc",      // structlog, stamina, pydantic-settings, secrets
    ".cursor/rules/project-scaffold.mdc"    // tree, uv, ruff/mypy, Makefile, Docker, CI
  ]

  // === Specialist rules — routed per agent (already implemented) ============
  // Each specialist rule is loaded via {file:...} at the top of its agent prompt in
  // `.opencode/agents/`. That is OpenCode's native equivalent of Cursor's glob scoping:
  // the rule loads only when that agent runs, not on every session.
  //
  //   eval-guardian.md    -> testing-and-eval.mdc
  //   docs-sync.md        -> architecture-docs.mdc
  //   docs-fix.md         -> architecture-docs.mdc + git-workflow.mdc
  //   security-auditor.md -> observability.mdc + ai-sdk-patterns.mdc
  //   pattern-scout.md    -> ai-sdk-patterns.mdc
  //   learn.md            -> learning-mode.mdc            (mode: primary, Tab-selectable)
  //
  // `streamlit-patterns.mdc` is narrow enough to reference ad hoc with @ when working
  // in `app/` — it does not need a standing route.
  //
  // NOTE: observability.mdc is in `instructions` AND routed to security-auditor. That is
  // intentional and harmless — a subagent runs in its own context, so there is no
  // double-load in a single window.
  //
  // Cursor loads all nine rules by glob automatically; nothing extra is needed there.
}
