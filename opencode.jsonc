{
  // ---------------------------------------------------------------------------
  // OpenCode project config  ·  Manuel Reyes  ·  Stage 1 — Internal AI Builder
  // Roadmap v10.0 (3-stage arc: Internal AI Builder → AI-Focused DE/AE → Applied
  // AI Engineer / FDE track).
  // Place at project root as `opencode.json` (or keep `.jsonc` for comments).
  // Docs verified: opencode.ai/docs/{providers,agents,commands,rules,config}
  // ---------------------------------------------------------------------------
  "$schema": "https://opencode.ai/config.json",

  // === Default + small model =================================================
  // Primary agents use `model` unless they override it. `small_model` handles
  // session titles/summaries — pinned LOCAL so finance work never leaks to cloud.
  "model": "openrouter/minimax/minimax-m3",
  "small_model": "ollama/qwen3.5-16k",

  // === Providers =============================================================
  "provider": {
    // Local, free, private — your finance/proprietary default.
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        // Key MUST match the Ollama tag exactly (run `ollama list`).
        "qwen3.5:9b":  { "name": "Qwen3.5 9B (local)" },
        "qwen3.5-16k": { "name": "Qwen3.5 9B · 16k (local)" }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": { "baseURL": "http://localhost:1234/v1" },
      "models": {
        "qwen3.5-9b": { "name": "Qwen3.5 9B · MLX (LM Studio)" }
      }
    },
    // OpenRouter is built-in — add the key once: /connect → OpenRouter → paste key
    // (stored in ~/.local/share/opencode/auth.json). Naming the slugs here just
    // makes them tidy to pick in /models and cycle with F2. Slugs are yours.
    "openrouter": {
      "models": {
        "minimax/minimax-m3":       { "name": "MiniMax M3 (build · default)" },
        "z-ai/glm-5.2":             { "name": "GLM-5.2 (build · alt)" },
        "qwen/qwen3.7-max":         { "name": "Qwen3.7 Max (build · alt)" },
        "deepseek/deepseek-v4-pro": { "name": "DeepSeek V4 Pro (plan · backup)" }
      }
    }
  },

  // === Built-in primary agents: your non-vibecode loop =======================
  "agent": {
    "plan": {
      // Default: fast/local planning. If the local 9B plans poorly, switch this
      // session via /models or F2, in order of preference:
      //   1) openrouter/z-ai/glm-5.2            (first fallback — runs clean in Plan)
      //   2) openrouter/deepseek/deepseek-v4-pro (last resort — can be slow / look
      //      frozen in Plan mode: reasoning-MoE + ai-sdk thinking-stream, not a hang)
      "model": "ollama/qwen3.5-16k",
      "permission": { "edit": "deny", "bash": "deny" }   // true read-only gate
    },
    "build": {
      // Default build model. If MiniMax struggles on a portion, switch this session
      // via /models or F2 to:  openrouter/z-ai/glm-5.2  or  openrouter/qwen/qwen3.7-max
      "model": "openrouter/minimax/minimax-m3",
      "permission": {
        "edit": "allow",              // looser: apply edits without a per-diff prompt
                                      // your gate is now the git-diff review + manual commit
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "make test": "allow",
          "make lint": "allow",
          "make eval": "allow",
          "make diagrams": "allow",
          "uv run pytest*": "allow",
          "uv run ruff*": "allow",
          "uv run mypy*": "allow",
          "pytest*": "allow",
          "ruff*": "allow",
          "mypy*": "allow",
          "git commit*": "deny",      // you ALWAYS commit manually
          "git push*": "deny"
        }
      }
    }
  },

  // === Rule loading ==========================================================
  // AGENTS.md is loaded automatically — it holds the behavioural contract and the
  // production non-negotiables. It is ALSO read natively by Cursor and Claude Code,
  // so it is the single portable source of truth.
  //
  // IMPORTANT: `instructions` is FLAT — OpenCode has no glob-activation semantics.
  // Every file listed here loads in EVERY session, regardless of the `globs:` /
  // `alwaysApply:` frontmatter (those are Cursor-only). So list only the rules that
  // apply to nearly all work; route the specialist rules per-agent instead (below).
  "instructions": [
    ".cursor/rules/python-core.mdc",        // style, types, docstrings, pandas, errors
    ".cursor/rules/observability.mdc",      // structlog, stamina, pydantic-settings, secrets
    ".cursor/rules/project-scaffold.mdc"    // tree, uv, ruff/mypy, Makefile, Docker, CI
  ]

  // === Specialist rules — routed per agent (already implemented) ============
  // Each specialist rule is loaded via {file:...} at the top of its agent prompt in
  // `.opencode/agents/`. That is OpenCode's native equivalent of Cursor's glob scoping:
  // the rule loads only when that agent runs, not on every session.
  //
  //   eval-guardian.md    -> testing-and-eval.mdc
  //   docs-sync.md        -> architecture-docs.mdc
  //   docs-fix.md         -> architecture-docs.mdc + git-workflow.mdc
  //   security-auditor.md -> observability.mdc + ai-sdk-patterns.mdc
  //   pattern-scout.md    -> ai-sdk-patterns.mdc
  //   learn.md            -> learning-mode.mdc            (mode: primary, Tab-selectable)
  //
  // `streamlit-patterns.mdc` is narrow enough to reference ad hoc with @ when working
  // in `app/` — it does not need a standing route.
  //
  // NOTE: observability.mdc is in `instructions` AND routed to security-auditor. That is
  // intentional and harmless — a subagent runs in its own context, so there is no
  // double-load in a single window.
  //
  // Cursor loads all nine rules by glob automatically; nothing extra is needed there.
}
