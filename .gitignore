# Build outputs
build/
dist/
*.egg-info/
src/*.egg-info/

# Virtual environments
venv/
env/
.venv/
.env/
**/venv/
**/env/

# Python
__pycache__/
__pycache__
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Output files (generated, don't commit)
**/outputs/*.txt
**/outputs/*.csv
**/outputs/*.json

# But keep .gitkeep
!**/outputs/.gitkeep
!*.gitkeep

# Data files (too large or sensitive)
**/data/*.csv
!**/data/mbox*.txt  # Keep sample files

# Quick testing and experiments
experiments/scratch.py

# Logs with sensitive info
*.log

# Claude Code — personal, never committed.
# `**/` so nested .claude/ dirs are covered too; a bare `.claude/...` pattern
# is anchored to the repo root and silently misses subdirectories.
**/.claude/settings.local.json
**/CLAUDE.local.md
**/.claude/agent-memory-local/
